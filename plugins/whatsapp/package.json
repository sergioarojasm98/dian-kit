{
  "name": "@dian-kit/plugin-whatsapp",
  "version": "0.0.2",
  "description": "WhatsApp agent for DIAN electronic invoicing — multi-tenant, Meta Cloud API, natural language",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check src/ webhook/ agent/ multi-tenant/",
    "lint:fix": "biome check --write src/ webhook/ agent/ multi-tenant/",
    "format": "biome format --write src/ webhook/ agent/ multi-tenant/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "author": "Sergio Rojas <dian-kit@sergioarojasm98.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergioarojasm98/dian-kit.git",
    "directory": "plugins/whatsapp"
  },
  "dependencies": {
    "@dian-kit/core": "workspace:*",
    "@dian-kit/sdk-node": "workspace:*",
    "@dian-kit/ai": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
