{
  "name": "@dian-kit/ai",
  "version": "0.0.1",
  "description": "Optional AI layer for dian-kit — BYOK: natural language invoicing, error explainer, compliance checker",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --dir tests/unit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "keywords": [
    "dian",
    "ai",
    "openai",
    "anthropic",
    "ollama",
    "byok",
    "factura-electronica"
  ],
  "author": "Sergio Rojas <dian-kit@sergioarojasm98.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergioarojasm98/dian-kit.git",
    "directory": "packages/ai"
  },
  "dependencies": {
    "@dian-kit/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
